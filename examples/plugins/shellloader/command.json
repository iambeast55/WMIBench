{
  "api_version": 3,
  "alias": "loader",
  "name": "Shellcode Loading",
  "description": "Inject a shellcode binary. https://github.com/tylerdotrar/ShellcodeLoaderPS/tree/main",
  "category": "Injection",
  "parameters": {
    "_schema": {
      "file": {"type": "str", "required": true, "description":"Local path to  binary file."},
      "processid": {"type": "int", "required": true, "description":"Remote Process ID to inject into."}
    }
  },
  "backends": ["winrm"],
  "modifies_remote": true,
  "entry_point": "implementation.py:run"
}
